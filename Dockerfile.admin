# ─── Stage 1: Install dependencies ───────────────────────────────────────────
FROM node:24-alpine AS deps
WORKDIR /app
COPY package*.json ./
RUN npm ci --ignore-scripts

# ─── Stage 2: Build the Angular admin panel ──────────────────────────────────
FROM node:24-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx nx build admin-panel --configuration=production

# ─── Stage 3: Serve with nginx ───────────────────────────────────────────────
FROM nginx:alpine AS runner

# Copy the built Angular app to nginx html directory
COPY --from=builder /app/dist/apps/admin-panel/browser /usr/share/nginx/html

# Custom nginx config for SPA routing
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]